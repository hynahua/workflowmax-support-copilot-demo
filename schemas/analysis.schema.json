{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"analysis",
  "type":"object",
  "additionalProperties":false,
  "required":["summary","intents","risk_flags","route","reason","draft","citation_ids"],
  "properties":{
    "summary":{"type":"string","minLength":1,"maxLength":600},
    "intents":{"type":"array","minItems":1,"maxItems":6,"uniqueItems":true,"items":{"enum":["how_to","bug_report","complaint","churn_signal","permission_question","unknown"]}},
    "risk_flags":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"enum":["bug","complaint","churn","financial_advice","access","locked_record","instruction_attack","uncertain"]}},
    "route":{"enum":["draft","clarify","escalate"]},
    "reason":{"type":"string","minLength":1,"maxLength":1200},
    "draft":{"type":"string","maxLength":4500},
    "citation_ids":{"type":"array","maxItems":3,"uniqueItems":true,"items":{"type":"string","pattern":"^K-[0-9]{3}$"}}
  }
}
