{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"knowledge",
  "type":"object",
  "additionalProperties":false,
  "required":["version","articles"],
  "properties":{
    "version":{"type":"string","minLength":1},
    "articles":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","title","url","publisher","source_updated","reviewed_at","locator","active","tags","summary","facts","conditions"],
      "properties":{
        "id":{"type":"string","pattern":"^K-[0-9]{3}$"},
        "title":{"type":"string","minLength":1},
        "url":{"type":"string","pattern":"^https://support\\.workflowmax\\.com/hc/en-us/articles/"},
        "publisher":{"type":"string","minLength":1},
        "source_updated":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "reviewed_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "locator":{"type":"string","minLength":1},
        "active":{"type":"boolean"},
        "tags":{"type":"array","minItems":1,"items":{"type":"string"}},
        "summary":{"type":"string","minLength":1},
        "facts":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "conditions":{"type":"array","items":{"type":"string","minLength":1}}
      }
    }}
  }
}
