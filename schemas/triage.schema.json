{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "triage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "how_to",
          "bug_report",
          "complaint",
          "churn_signal",
          "permission_question",
          "unknown"
        ]
      }
    },
    "risk_flags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "bug",
          "complaint",
          "churn",
          "financial_advice",
          "access",
          "locked_record",
          "instruction_attack",
          "uncertain"
        ]
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "human_requested": {
      "type": "boolean"
    },
    "decision": {
      "enum": [
        "retrieve",
        "clarify",
        "handoff"
      ]
    },
    "missing_information": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "screen",
          "task",
          "error_message"
        ]
      }
    },
    "clarification": {
      "type": "string",
      "maxLength": 500
    },
    "search_queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "summary",
    "intents",
    "risk_flags",
    "reason",
    "human_requested",
    "decision",
    "missing_information",
    "clarification",
    "search_queries"
  ]
}
